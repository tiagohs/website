TiYqgpQdGw4PZdT.jpg","name":"Saoirse Ronan","winner":false,"movie":{"type":"movie","id":331482,"name":"Little Women","image_path":"/oXRJlVPJO8GqPPpJwbomQEpAi3N.jpg","director":"Greta Gerwig","winner":false}}]},{"type":"awards_nominees","name":"Best Supporting Actor","nominee_list":[{"type":"person","id":287,"image_path":"/cckcYc2v0yh1tc9QjRelptcOBko.jpg","name":"Brad Pitt","winner":true,"movie":{"type":"movie","id":466272,"name":"Once Upon a Time... in Hollywood","image_path":"/gMEKjlq4JcLR93oAVSD47MSeO9h.jpg","director":"Quentin Tarantino","winner":false}},{"type":"person","id":31,"image_path":"/tAyAXPLnR9Sgi7x2lMV4PUPitai.jpg","name":"Tom Hanks","winner":false,"movie":{"type":"movie","id":501907,"name":"A Beautiful Day in the Neighborhood","image_path":"/qenbW0aWvW8bxNb0XVDPeIUwFVu.jpg","director":"Marielle Heller","winner":true}},{"type":"person","id":4517,"image_path":"/iX8b8KL8cezzxw1FnH978h9ob48.jpg","name":"Joe Pesci","winner":false,"movie":{"type":"movie","id":398978,"name":"The Irishman","image_path":"/mFyQRQoUh8InlwmE5fRd9LOBRZ1.jpg","director":"Martin Scorsese","winner":false}},{"type":"person","id":1158,"image_path":"/fMDFeVf0pjopTJbyRSLFwNDm8Wr.jpg","name":"Al Pacino","winner":false,"movie":{"type":"movie","id":398978,"name":"The Irishman","image_path":"/mFyQRQoUh8InlwmE5fRd9LOBRZ1.jpg","director":"Martin Scorsese","winner":false}},{"type":"person","id":4173,"image_path":"/9ukJS2QWTJ22HcwR1ktMmoJ6RSL.jpg","name":"Anthony Hopkins","winner":false,"movie":{"type":"movie","id":551332,"name":"The Two Popes","image_path":"/oOjACi3zgscAFmgzJhNe3aZVhaW.jpg","director":"Fernando Meirelles"}}]},{"type":"block_special","title":"Reception","description":"An estimated 23.6 million viewers watched the ceremony live, with a 5.3 rating among key demographic viewers. That was a 20% drop from the previous year's ceremony, making it the least-watched Oscars ceremony of all time. The ceremony was still ranked as the most-watched awards show of the 2019–2020 television season in the United States, since declining viewership has been observed across all awards shows in recent years. The 2020 Oscars were also one of the last live programs to air in the United States amid the current upheaval in the overall show schedule caused by the COVID-19 pandemic."},{"type":"awards_nominees","name":"Best Supporting Actress","nominee_list":[{"type":"person","id":4784,"image_path":"/2Ryt0SsExqWrLTzBu6sZcbLwoDJ.jpg","name":"Laura Dern","winner":true,"movie":{"type":"movie","id":492188,"name":"Marriage Story","image_path":"/LaZ5rwaMvVH20J8O2Nu9uuXGI5.jpg","director":"Noah Baumbach","winner":false}},{"type":"person","id":8534,"image_path":"/3MsayDvY73uXGVbCFHyy1ABTacV.jpg","name":"Kathy Bates","winner":false,"movie":{"type":"movie","id":292011,"name":"Richard Jewell","image_path":"/koGknmSPrlDxzb5hvqn7CT5Uqt.jpg","director":"Clint Eastwood","winner":false}},{"type":"person","id":1373737,"image_path":"/75PvULemW8BvheSKtPMoBBsvPLh.jpg","name":"Florence Pugh","winner":false,"movie":{"type":"movie","id":331482,"name":"Little Women","image_path":"/oXRJlVPJO8GqPPpJwbomQEpAi3N.jpg","director":"Greta Gerwig","winner":false}},{"type":"person","id":234352,"image_path":"/ecv9SBN9m1cEZFfSopph6wf8fk.jpg","name":"Margot Robbie","winner":false,"movie":{"type":"movie","id":525661,"name":"Bombshell","image_path":"/s7DTu2TAOzIcunFtFyqzyYoICiy.jpg","director":"Jay Roach"}},{"type":"person","id":1245,"image_path":"/6NsMbJXRlDZuDzatN2akFdGuTvx.jpg","name":"Scarlett Johansson","winner":false,"movie":{"type":"movie","id":515001,"name":"Jojo Rabbit","image_path":"/vC7gB8h8KFTsraAoKsj0haHAljR.jpg","director":"Taika Waititi","winner":false}}]},{"type":"awards_nominees","name":"Best Animated Feature","nominee_list":[{"type":"movie","id":301528,"name":"Toy Story 4","image_path":"/AkrRD3Lnwb82Stu2SpDKAerK6O2.jpg","director":"Josh Cooley","winner":true},{"type":"movie","id":166428,"name":"How to Train Your Dragon: The Hidden World","image_path":"/5uqxMHM7YLKk6yni4bOE0D6DVz8.jpg","director":"Dean DeBlois","winner":false},{"type":"movie","id":586940,"name":"I Lost My Body","image_path":"/jH0mknMEByXUDTfiS1SQOxYDL5z.jpg","director":"Jérémy Clapin","winner":false},{"type":"movie","id":508965,"name":"Klaus","image_path":"/aLniylyJlbXEdxvaGSuQkRACWUx.jpg","director":"Sergio Pablos","winner":false},{"type":"movie","id":458253,"name":"Missing Link","image_path":"/f4yoHMsJsCt9UNmxa6LR3Vjl2z4.jpg","director":"Chris Butler","winner":false}]},{"type":"video","video_id":"ekMl5VHBH4I","information":{"contentTitle":"Bong Joon Ho wins Best Director","contentText":"When accepting the award for Best Director, Bong Joon-ho said through his interpreter: \"When I was young and studying cinema, there was a saying that I carved deep into my heart, which is, 'The most personal is the most creative.'\" He then said in English that the quote had come from \"our great Martin Scorsese,\" which led the audience to give Scorsese an enthusiastic ovation. Bong later confirmed at a press conference with South Korean media that he had read the quote in a book written by David Thompson; Bong did not mention the book's title at the time, but it turned out to be Scorsese on Scorsese, co-written by Thompson and Ian Christie.","source":"YouTube: <i>MrHampiano</i> channel"}},{"type":"awards_nominees","name":"Best Cinematography","nominee_list":[{"type":"movie","id":530915,"name":"1917","image_path":"/8KkyXE7Hd9MPOOkORxkMM6SUXAB.jpg","director":"Sam Mendes","winner":true},{"type":"movie","id":466272,"name":"Once Upon a Time... in Hollywood","image_path":"/gMEKjlq4JcLR93oAVSD47MSeO9h.jpg","director":"Quentin Tarantino","winner":false},{"type":"movie","id":398978,"name":"The Irishman","image_path":"/mFyQRQoUh8InlwmE5fRd9LOBRZ1.jpg","director":"Martin Scorsese","winner":false},{"type":"movie","id":475557,"name":"Joker","image_path":"/xLxgVxFWvb9hhUyCDDXxRPPnFck.jpg","director":"Todd Phillips","winner":false},{"type":"movie","id":466272,"name":"Once Upon a Time... in Hollywood","image_path":"/gMEKjlq4JcLR93oAVSD47MSeO9h.jpg","director":"Quentin Tarantino","winner":false}]},{"type":"awards_nominees","name":"Best Director","nominee_list":[{"type":"person","id":21684,"image_path":"/tKLJBqbdH6HFj2QxLA5o8Zk7IVs.jpg","name":"Bong Joon-ho","winner":true,"movie":{"type":"movie","id":496243,"name":"Parasite","image_path":"/igw938inb6Fy0YVcwIyxQ7Lu5FO.jpg","director":"Bong Joon-ho","winner":true}},{"type":"person","id":1032,"image_path":"/9U9Y5GQuWX3EZy39B8nkk4NY01S.jpg","name":"Martin Scorsese","winner":false,"movie":{"type":"movie","id":398978,"name":"The Irishman","image_path":"/mFyQRQoUh8InlwmE5fRd9LOBRZ1.jpg","director":"Martin Scorsese","winner":false}},{"type":"person","id":57130,"image_path":"/A6FPht87DiqXzp456WjakLi2AtP.jpg","name":"Todd Phillips","winner":false,"movie":{"type":"movie","id":475557,"name":"Joker","image_path":"/xLxgVxFWvb9hhUyCDDXxRPPnFck.jpg","director":"Todd Phillips","winner":false}},{"type":"person","id":45400,"image_path":"/3H0xzU12GTNJyQTpGysEuI9KyiQ.jpg","name":"Greta Gerwig","winner":false,"movie":{"type":"movie","id":331482,"name":"Little Women","image_path":"/oXRJlVPJO8GqPPpJwbomQEpAi3N.jpg","director":"Greta Gerwig","winner":false}},{"type":"person","id":39,"image_path":"/5z89X9rB76JDblqMQ52fviwXxAN.jpg","name":"Sam Mendes","winner":false,"movie":{"type":"movie","id":530915,"name":"1917","image_path":"/8KkyXE7Hd9MPOOkORxkMM6SUXAB.jpg","director":"Sam Mendes","winner":false}}]},{"type":"awards_nominees","name":"Best Costume Design","nominee_list":[{"type":"movie","id":331482,"name":"Little Women","image_path":"/oXRJlVPJO8GqPPpJwbomQEpAi3N.jpg","director":"Greta Gerwig","winner":true},{"type":"movie","id":398978,"name":"The Irishman","image_path":"/mFyQRQoUh8InlwmE5fRd9LOBRZ1.jpg","director":"Martin Scorsese","winner":false},{"type":"movie","id":515001,"name":"Jojo Rabbit","image_path":"/vC7gB8h8KFTsraAoKsj0haHAljR.jpg","director":"Taika Waititi","winner":false},{"type":"movie","id":475557,"name":"Joker","image_path":"/xLxgVxFWvb9hhUyCDDXxRPPnFck.jpg","director":"Todd Phillips","winner":false},{"type":"movie","id":466272,"name":"Once Upon a Time... in Hollywood","image_path":"/gMEKjlq4JcLR93oAVSD47MSeO9h.jpg","director":"Quentin Tarantino","winner":false}]},{"type":"video","video_id":"MqAe7U54ry0","information":{"contentTitle":"James Corden and Rebel Wilson Funny ‘Cats’ Oscars Skit","contentText":"James Corden and Rebel Wilson presented the award for Best Visual Effects dressed in cat costumes to satirize their lead roles in Cats (a film heavily criticized for its visual effects, among other things) and told the audience: \"As cast members of the motion picture Cats, nobody more than us understands the importance of good visual effects.\"; Mills said that Corden came up with the idea. The next day, February 10, 2020, the Visual Effects Society issued a statement criticizing Corden and Wilson's bit, commenting that \"[the] best visual effects in the world won't make up for a poorly told story\"","source":"YouTube: <i>Oscars</i> channel"}},{"type":"awards_nominees","name":"Best Documentary Feature","nominee_list":[{"type":"movie","id":565716,"name":"American Factory","image_path":"/9kLpTYpnbnJWq6IwY6DOyyEDaN3.jpg","director":"Julia Reichert","winner":true},{"type":"movie","id":621729,"name":"The Cave","image_path":"/2Zb8U2EXBv36DGG9jaEESNEeJv9.jpg","director":"Feras Fayyad","winner":false},{"type":"movie","id":566221,"name":"The Edge of Democracy","image_path":"/z2aPe57jyW0TPYLVBXb8T0yBFGQ.jpg","director":"Petra Costa","winner":false},{"type":"movie","id":576017,"name":"For Sama","image_path":"/w8ZytqAN2B56ejEvIVjubVNL3oo.jpg","director":"Edward Watts","winner":false},{"type":"movie","id":566213,"name":"Honeyland","image_path":"/6JfuTYYMB2Af6Iw5cEmpIOx5OSW.jpg","director":"Tamara Kotevska","winner":false}]},{"type":"awards_nominees","name":"Best Documentary Short Subject","nominee_list":[{"type":"movie","id":612074,"name":"Learning to Skateboard in a Warzone (If You're a Girl)","image_path":"/c5F2SBvq7MOYlkoaI5mmlb5V5ka.jpg","director":"Carol Dysinger","winner":true},{"type":"movie","id":592303,"name":"In the Absence","image_path":"/7VQ6eu8U7Dp8FaD71USIxk9yQ4Y.jpg","director":"Yi Seung-jun","winner":false},{"type":"movie","id":593280,"name":"Life Overtakes Me","image_path":"/fHO4wOw7u6B9yIzLuKf0UBO7GmO.jpg","director":"Kristine Samuelson","winner":false},{"type":"movie","id":634767,"name":"St. Louis Superman","image_path":"/","director":"Smriti Mundhra","winner":false},{"type":"movie","id":634767,"name":"St. Louis Superman","image_path":"/qV4eTXHQSumCDbJzEJizoBFR6Pe.jpg","director":"","winner":false}]},{"type":"awards_nominees","name":"Best Film Editing","nominee_list":[{"type":"movie","id":359724,"name":"Ford v Ferrari","image_path":"/4hQD9xGJOh7e0h3Md6BB8oxtPQS.jpg","director":"James Mangold","winner":true},{"type":"movie","id":398978,"name":"The Irishman","image_path":"/mFyQRQoUh8InlwmE5fRd9LOBRZ1.jpg","director":"Martin Scorsese","winner":false},{"type":"movie","id":515001,"name":"Jojo Rabbit","image_path":"/vC7gB8h8KFTsraAoKsj0haHAljR.jpg","director":"Taika Waititi","winner":false},{"type":"movie","id":475557,"name":"Joker","image_path":"/xLxgVxFWvb9hhUyCDDXxRPPnFck.jpg","director":"Todd Phillips","winner":false},{"type":"movie","id":496243,"name":"Parasite","image_path":"/igw938inb6Fy0YVcwIyxQ7Lu5FO.jpg","director":"Bong Joon-ho","winner":false}]},{"type":"block_special","title":"Ceremony","description":"At its board meeting in April 2019, the Academy voted to rename the \"Best Foreign Language Film\" category to \"Best International Feature Film.\" Animated films and documentaries would also qualify for the renamed award, but the remaining criteria would stay the same, requiring entries to have most of their dialogue in a language other than English. The Best Makeup and Hairstyling category was expanded from seven finalists and three nominees to ten finalists and five nominees.<br/><br/>\n\nOn January 9, 2020, ABC Entertainment president Karey Burke revealed that, for the second year in a row, the ceremony would not have a host, citing the success of the format at the previous ceremony (when comedian Kevin Hart had stepped down from the role). Burke promised that the ceremony would showcase \"big entertainment values, big musical numbers, comedy and star power.\""},{"type":"awards_nominees","name":"Best International Feature Film","nominee_list":[{"type":"movie","id":496243,"name":"Parasite","image_path":"/igw938inb6Fy0YVcwIyxQ7Lu5FO.jpg","director":"Bong Joon-ho","winner":true},{"type":"movie","id":519010,"name":"Pain and Glory","image_path":"/bScM0AHRktwfMxmt7lP6IjV7KPR.jpg","director":"Pedro Almodóvar","winner":false},{"type":"movie","id":586863,"name":"Les Misérables","image_path":"/ywO4oyCfohDvrbU7motFRd2WdqL.jpg","director":"Ladj Ly","winner":false},{"type":"movie","id":566213,"name":"Honeyland","image_path":"/6JfuTYYMB2Af6Iw5cEmpIOx5OSW.jpg","director":"Tamara Kotevska","winner":false},{"type":"movie","id":471707,"name":"Corpus Christi","image_path":"/94l5tagsFM2x8SFa0ANtUrcB5Il.jpg","director":"Jan Komasa","winner":false}]},{"type":"awards_nominees","name":"Best Makeup and Hairstyling","nominee_list":[{"type":"movie","id":525661,"name":"Bombshell","image_path":"/s7DTu2TAOzIcunFtFyqzyYoICiy.jpg","director":"Jay Roach","winner":true},{"type":"movie","id":475557,"name":"Joker","image_path":"/xLxgVxFWvb9hhUyCDDXxRPPnFck.jpg","director":"Todd Phillips","winner":false},{"type":"movie","id":530915,"name":"1917","image_path":"/8KkyXE7Hd9MPOOkORxkMM6SUXAB.jpg","director":"Sam Mendes","winner":false},{"type":"movie","id":491283,"name":"Judy","image_path":"/bbS0KWxQPMTiQ53WooVgCIgEWnc.jpg","director":"Rupert Goold","winner":false},{"type":"movie","id":420809,"name":"Maleficent: Mistress of Evil","image_path":"/oP3TasnCKqSvGDv0sHLUhpioNVb.jpg","director":"Joachim Rønning","winner":false}]},{"type":"awards_nominees","name":"Best Original Score","nominee_list":[{"type":"movie","id":475557,"name":"Joker","image_path":"/xLxgVxFWvb9hhUyCDDXxRPPnFck.jpg","director":"Todd Phillips","winner":true},{"type":"movie","id":331482,"name":"Little Women","image_path":"/oXRJlVPJO8GqPPpJwbomQEpAi3N.jpg","director":"Greta Gerwig","winner":false},{"type":"movie","id":492188,"name":"Marriage Story","image_path":"/LaZ5rwaMvVH20J8O2Nu9uuXGI5.jpg","director":"Noah Baumbach","winner":false},{"type":"movie","id":530915,"name":"1917","image_path":"/8KkyXE7Hd9MPOOkORxkMM6SUXAB.jpg","director":"Sam Mendes","winner":false},{"type":"movie","id":181812,"name":"Star Wars: The Rise of Skywalker","image_path":"/lFx2i2pg1BoaD7grcpGDyHM1eML.jpg","director":"J.J. Abrams","winner":false}]},{"type":"video","video_id":"Nhe-LJLZMHk","information":{"contentTitle":"Eminem - Lose Yourself Live at the 2020 Oscars","contentText":"A highlight of the ceremony was Eminem's surprise performance of \"Lose Yourself,\" from the film 8 Mile (2002). The song was nominated for and won Best Original Song in 2003, but Eminem declined to attend the ceremony because he lacked confidence that the song would actually win, among other factors. The idea of bringing Eminem back originated with Mills and the Academy, who wanted to keep a \"high-energy\" musical act in line with the opening performances by Justin Timberlake and Queen + Adam Lambert at the 2017 and 2019 editions, respectively, as well as to find a way to give Eminem the chance to perform his winning song. In addition, Eminem found the timing opportune, as he had just released a new album, Music to Be Murdered By. The performance was a closely guarded secret among the ceremony's producers, and Eminem would have the option of pulling out of the show if his involvement in the awards was discovered before it took place; his performance was therefore scheduled for the middle of the ceremony rather than as an opening act, so that if he backed out, it would not disrupt the program.","source":"YouTube: <i>Mauser932</i> channel"}},{"type":"awards_nominees","name":"Best Original Song","nominee_list":[{"type":"movie","id":504608,"name":"Rocketman","image_path":"/tCfzNtsMVGYVJNsAEgVCBmuXHYF.jpg","director":"(I'm Gonna) Love Me Again","winner":true},{"type":"movie","id":301528,"name":"Toy Story 4","image_path":"/AkrRD3Lnwb82Stu2SpDKAerK6O2.jpg","director":"I Can't Let You Throw Yourself Away","winner":false},{"type":"movie","id":506528,"name":"Harriet","image_path":"/wFfn2PISJ8u4Ui45kIY6vASEHjq.jpg","director":"Stand Up","winner":false},{"type":"movie","id":514439,"name":"Breakthrough","image_path":"/qNrL1DAHxLA5Bh5sc2xMWJ1pHa8.jpg","director":"I'm Standing With You","winner":false},{"type":"movie","id":330457,"name":"Frozen II","image_path":"/g6n7TdQSgozArIM0okXTjjCM9Np.jpg","director":"Into The Unknown","winner":false}]},{"type":"awards_nominees","name":"Best Production Design","nominee_list":[{"type":"movie","id":466272,"name":"Once Upon a Time... in Hollywood","image_path":"/gMEKjlq4JcLR93oAVSD47MSeO9h.jpg","director":"Quentin Tarantino","winner":true},{"type":"movie","id":496243,"name":"Parasite","image_path":"/igw938inb6Fy0YVcwIyxQ7Lu5FO.jpg","director":"Bong Joon-ho","winner":false},{"type":"movie","id":398978,"name":"The Irishman","image_path":"/mFyQRQoUh8InlwmE5fRd9LOBRZ1.jpg","director":"Martin Scorsese","winner":false},{"type":"movie","id":515001,"name":"Jojo Rabbit","image_path":"/vC7gB8h8KFTsraAoKsj0haHAljR.jpg","director":"Taika Waititi","winner":false},{"type":"movie","id":530915,"name":"1917","image_path":"/8KkyXE7Hd9MPOOkORxkMM6SUXAB.jpg","director":"Sam Mendes","winner":false}]},{"type":"awards_nominees","name":"Best Animated Short Film","nominee_list":[{"type":"movie","id":589739,"name":"Hair Love","image_path":"/pm9uRa7031Z56unxNE8AqE8f2wg.jpg","director":"Matthew A. Cherry","winner":true},{"type":"movie","id":613221,"name":"Daughter","image_path":"/55aCc3X19i3BSUj4pEzedO4C7VP.jpg","director":"Daria Kashcheeva","winner":false},{"type":"movie","id":574074,"name":"Kitbull","image_path":"/xfY5c9AVzxnMMQH1fj1mkG0SzFf.jpg","di