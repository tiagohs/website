idente","image_path":"/tNRnqTcrbJQQd4MfthlPXoY4FNC.jpg","director":"Jafar Panahi"}},{"type":"person","id":227565,"name":"Ronald Bronstein e Josh Safdie","image_path":"/bJMZgSCdMdjQ2cojJagewm963aT.jpg","winner":false,"movie":{"type":"movie","id":1317288,"name":"Marty Supremo","image_path":"/oLWBW1Sg9V8KGgbR3Y8jeEWF2Gi.jpg","director":"Josh Safdie"}},{"type":"person","id":444892,"name":"Eskil Vogt e Joachim Trier","image_path":"/y5Rg3vdQleveYe7VfyGve4ljDtV.jpg","winner":false,"movie":{"type":"movie","id":1124566,"name":"Valor sentimental","image_path":"/pTMpLRfB9wUaQ8CEdGEUkyVXwOo.jpg","director":"Joachim Trier"}}]},{"type":"awards_nominees","name":"Mejor Casting","nominee_list":[{"type":"movie","id":1054867,"name":"Una batalla tras otra","image_path":"/2peYXW6CoruehDnKJGMjl2NuaNB.jpg","director":"Paul Thomas Anderson","winner":true,"backdrop_path":"/zpEWFNqoN8Qg1SzMMHmaGyOBTdW.jpg"},{"type":"movie","id":858024,"name":"Hamnet","image_path":"/njatIGrIlZCxB88UUBC2xgmfCNE.jpg","director":"Chloé Zhao","winner":false},{"type":"movie","id":1317288,"name":"Marty Supremo","image_path":"/oLWBW1Sg9V8KGgbR3Y8jeEWF2Gi.jpg","director":"Josh Safdie","winner":false},{"type":"movie","id":1220564,"name":"El agente secreto","image_path":"/t1DQ4XXIqTm5LvUjz8jypN43JjZ.jpg","director":"Kleber Mendonça Filho","winner":false},{"type":"movie","id":1233413,"name":"Pecadores","image_path":"/v0Ljeti537c6cNKweuEN0iaU3x4.jpg","director":"Ryan Coogler","winner":false}]},{"type":"video","video_id":"Lif4Gc1Fh9k","information":{"contentTitle":"Cassandra Kulukundis recibe el primer Oscar a Mejor Casting","source":"YouTube: Canal <i>Oscars</i>"}},{"type":"block_special","title":"Récords y curiosidades","description":"<a href=\"https://_{type: 'screen', 'id': 1385904, 'screen_type': person}\">Autumn Durald Arkapaw</a>, de <a href=\"https://_{type: 'screen', 'id': 1233413, 'screen_type': movie}\">Sinners</a> (Pecadores, 2025), fue la primera mujer en ganar el Oscar a Mejor Fotografía. En Mejor Cortometraje hubo un empate entre <a href=\"https://_{type: 'screen', 'id': 1442908, 'screen_type': movie}\">The Singers</a> (Los cantores rusos, 2026) y <a href=\"https://_{type: 'screen', 'id': 1340625, 'screen_type': movie}\">Deux personnes échangeant de la salive</a> (Dos personas intercambiando saliva, 2025), el primer empate en los Oscar desde 2013. <a href=\"https://_{type: 'screen', 'id': 23882, 'screen_type': person}\">Amy Madigan</a> obtuvo la nominación por <a href=\"https://_{type: 'screen', 'id': 1078605, 'screen_type': movie}\">Weapons</a> (La hora de la desaparición, 2025) 40 años después de la primera, por <a href=\"https://_{type: 'screen', 'id': 123049, 'screen_type': movie}\">Twice in a Lifetime</a> (La vida puede continuar, 1985), el mayor intervalo entre nominaciones de una actriz. <a href=\"https://_{type: 'screen', 'id': 2228, 'screen_type': person}\">Sean Penn</a> no asistió a la ceremonia, y el premio a Mejor Actor de Reparto lo recibió en su nombre <a href=\"https://_{type: 'screen', 'id': 18793, 'screen_type': person}\">Kieran Culkin</a>."}]}
