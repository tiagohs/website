,{"type":"person","id":120229,"name":"Jafar Panahi","image_path":"/viZZkkfcuWze68bvUiMZmYZe8Qg.jpg","winner":false,"movie":{"type":"movie","id":1456349,"name":"Foi Apenas um Acidente","image_path":"/tNRnqTcrbJQQd4MfthlPXoY4FNC.jpg","director":"Jafar Panahi"}},{"type":"person","id":227565,"name":"Ronald Bronstein e Josh Safdie","image_path":"/bJMZgSCdMdjQ2cojJagewm963aT.jpg","winner":false,"movie":{"type":"movie","id":1317288,"name":"Marty Supreme","image_path":"/oLWBW1Sg9V8KGgbR3Y8jeEWF2Gi.jpg","director":"Josh Safdie"}},{"type":"person","id":444892,"name":"Eskil Vogt e Joachim Trier","image_path":"/y5Rg3vdQleveYe7VfyGve4ljDtV.jpg","winner":false,"movie":{"type":"movie","id":1124566,"name":"Valor Sentimental","image_path":"/pTMpLRfB9wUaQ8CEdGEUkyVXwOo.jpg","director":"Joachim Trier"}}]},{"type":"awards_nominees","name":"Melhor Escalação de Elenco","nominee_list":[{"type":"movie","id":1054867,"name":"Uma Batalha Após a Outra","image_path":"/2peYXW6CoruehDnKJGMjl2NuaNB.jpg","director":"Paul Thomas Anderson","winner":true,"backdrop_path":"/zpEWFNqoN8Qg1SzMMHmaGyOBTdW.jpg"},{"type":"movie","id":858024,"name":"Hamnet: A Vida Antes de Hamlet","image_path":"/njatIGrIlZCxB88UUBC2xgmfCNE.jpg","director":"Chloé Zhao","winner":false},{"type":"movie","id":1317288,"name":"Marty Supreme","image_path":"/oLWBW1Sg9V8KGgbR3Y8jeEWF2Gi.jpg","director":"Josh Safdie","winner":false},{"type":"movie","id":1220564,"name":"O Agente Secreto","image_path":"/t1DQ4XXIqTm5LvUjz8jypN43JjZ.jpg","director":"Kleber Mendonça Filho","winner":false},{"type":"movie","id":1233413,"name":"Pecadores","image_path":"/v0Ljeti537c6cNKweuEN0iaU3x4.jpg","director":"Ryan Coogler","winner":false}]},{"type":"video","video_id":"Lif4Gc1Fh9k","information":{"contentTitle":"Cassandra Kulukundis recebe o primeiro Oscar de Melhor Escalação de Elenco","source":"Youtube: Canal <i>Oscars</i>"}},{"type":"block_special","title":"Recordes e curiosidades","description":"<a href=\"https://_{type: 'screen', 'id': 1385904, 'screen_type': person}\">Autumn Durald Arkapaw</a>, de <a href=\"https://_{type: 'screen', 'id': 1233413, 'screen_type': movie}\">Sinners</a> (BR: Pecadores, 2025), foi a primeira mulher a vencer o Oscar de Melhor Fotografia. Em Melhor Curta Metragem houve empate entre <a href=\"https://_{type: 'screen', 'id': 1442908, 'screen_type': movie}\">The Singers</a> (BR: Os Cantores, 2026) e <a href=\"https://_{type: 'screen', 'id': 1340625, 'screen_type': movie}\">Deux personnes échangeant de la salive</a> (BR: Two People Exchanging Saliva, 2025), o primeiro empate do Oscar desde 2013. <a href=\"https://_{type: 'screen', 'id': 23882, 'screen_type': person}\">Amy Madigan</a> chegou à indicação por <a href=\"https://_{type: 'screen', 'id': 1078605, 'screen_type': movie}\">Weapons</a> (BR: A Hora do Mal, 2025) 40 anos depois da primeira, por <a href=\"https://_{type: 'screen', 'id': 123049, 'screen_type': movie}\">Twice in a Lifetime</a> (BR: Duas Vezes na Vida, 1985), o maior intervalo entre indicações de uma atriz. <a href=\"https://_{type: 'screen', 'id': 2228, 'screen_type': person}\">Sean Penn</a> não compareceu à cerimônia, e o prêmio de Melhor Ator Coadjuvante foi recebido em seu nome por <a href=\"https://_{type: 'screen', 'id': 18793, 'screen_type': person}\">Kieran Culkin</a>."}]}
